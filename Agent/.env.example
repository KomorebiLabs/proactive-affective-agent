# ==============================================================================
# 婉情AI - Agent 环境变量配置模板（Python AI 层 / 端口 8001）
# ==============================================================================
# 使用方式：复制此文件为 Agent/.env，填写真实密钥
#   cp Agent/.env.example Agent/.env
# ==============================================================================

# --- HuggingFace 镜像（解决国内网络无法访问 huggingface.co 的问题）---
HF_ENDPOINT=https://hf-mirror.com

# --- OSS (阿里云对象存储) 配置 ---
# 用于 ASR 语音识别时上传音频文件到 OSS，获取公网 URL
# 获取方式：阿里云控制台 → 对象存储 OSS → 开通服务 → 创建 Bucket → 复制 AccessKey
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com      # 根据你的 OSS 地域选择
OSS_BUCKET=your_bucket_name                   # 你的 Bucket 名称

# --- DeepSeek API（主大脑 - 必需）---
# 获取方式：https://platform.deepseek.com/ → API Keys → 创建密钥
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Qwen-VL / DashScope（视觉语言模型 + ASR 语音识别）---
# 获取方式：https://dashscope.console.aliyun.com/ → API-KEYs → 创建密钥
# 注意：ASR 语音识别（阿里云 Paraformer 模型）也使用此 Key
QWEN_API_KEY=your-qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- TTS 语音合成（可选，推荐 edge 免费）---
TTS_PROVIDER=edge  # edge(推荐免费) | volcengine | dashscope
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural  # 晓晓，年轻女声

# --- Notion API（情绪日记 - 可选）---
# 获取方式：https://www.notion.so/my-integrations → 创建集成 → 获取 API Key
# Database ID：在 Notion 数据库页面 URL 中复制（长的那一段）
NOTION_API_KEY=ntn_your_notion_api_key
NOTION_DATABASE_ID=your_notion_database_id

# --- Redis（可选，不配置则使用本地降级）---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- 日志 ---
LOG_LEVEL=INFO

# --- 演示模式（设为 true 则跳过真实感知，使用 Mock 数据）---
DEMO_MODE=false
