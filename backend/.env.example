# ==============================================================================
# 婉情AI - Backend 环境变量配置模板（Python 感知服务 / 端口 8000）
# ==============================================================================
# 使用方式：复制此文件为 backend/.env，填写真实密钥
#   cp backend/.env.example backend/.env
# ==============================================================================

# --- OSS (阿里云对象存储) 配置 ---
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET=your_bucket_name

# --- DeepSeek API（情感对话大脑）---
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Qwen/DashScope API（视觉理解 + ASR 语音识别）---
QWEN_API_KEY=your-qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- MySQL（Java Spring Boot 数据库凭据，本文件已被 .gitignore 忽略）---
MYSQL_USERNAME=root
MYSQL_PASSWORD=your_mysql_password
# MYSQL_URL=jdbc:mysql://127.0.0.1:3306/wanqing_ai?useUnicode=true&characterEncoding=utf-8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true

# --- Redis（可选）---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- 音频录制参数（通常无需修改）---
AUDIO_CHUNK=1024
AUDIO_FORMAT=16
AUDIO_CHANNELS=1
AUDIO_RATE=16000

# --- 日志 ---
LOG_LEVEL=INFO
