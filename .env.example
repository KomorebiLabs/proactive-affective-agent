# ==============================================================================
# 婉情AI - 配置参数（.env）
# ==============================================================================
# 此文件为配置模板，请复制为 .env 并填写你自己的真实密钥。
# Python 代码（如 dict、list、def）请勿写入此文件，应写在 config.py 中。
# ==============================================================================

# --- HuggingFace 镜像（解决国内网络无法访问 huggingface.co 的问题）---
HF_ENDPOINT=https://hf-mirror.com

# --- OSS (对象存储) 配置 ---
OSS_ACCESS_KEY_ID=your_oss_access_key_id
OSS_ACCESS_KEY_SECRET=your_oss_access_key_secret
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET=your_bucket_name

# --- Deepseek API（主大脑）---
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- Qwen-VL / DashScope（视觉语言模型）---
QWEN_API_KEY=sk-your-qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# --- TTS / ASR（语音合成与识别，通常复用 QWEN_API_KEY）---
TTS_PROVIDER=edge  # edge(推荐) | volcengine | dashscope
TTS_MODEL=cosyvoice-v1
TTS_VOICE=longwan
ASR_MODEL_DIR=iic/SenseVoiceSmall

# --- Edge TTS（微软免费语音，推荐用于中文）---
EDGE_TTS_VOICE=zh-CN-XiaoxiaoNeural  # 晓晓，年轻女声，自然流畅

# --- Notion API（情绪日记 Tool Calling）---
NOTION_API_KEY=ntn_your_notion_api_key
NOTION_DATABASE_ID=your_notion_database_id

# --- Redis（可选，不配置则使用本地降级）---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=your_redis_password  # 如有密码取消注释

# --- MySQL（Java 后端数据库）---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=wanqing_ai

# --- Java 回调地址（Python → Java 会话日志持久化）---
JAVA_CALLBACK_URL=http://localhost:8080

# --- 音频录制参数 ---
AUDIO_CHUNK=1024
AUDIO_FORMAT=16
AUDIO_CHANNELS=1
AUDIO_RATE=16000
AUDIO_WAVE_OUTPUT_FILENAME=output.wav

# --- 日志 ---
LOG_LEVEL=INFO
LOG_FILE=behavior_log.txt
SUMMARY_HOTKEY=ctrl+shift+s

# --- 每日总结调度 ---
DAILY_SUMMARY_HOUR=17
DAILY_SUMMARY_MINUTE=30
